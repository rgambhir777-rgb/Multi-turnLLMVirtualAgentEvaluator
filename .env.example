# AgentProof configuration. Copy to .env (start.bat / start.sh do this for you).
# Everything is optional: with no keys AgentProof runs fully offline with the heuristic judge.
# Values can also be edited on the Settings page, which writes them to this file.

# --- Server ---------------------------------------------------------------
AGENTPROOF_HOST=127.0.0.1
AGENTPROOF_PORT=8000
# Set to 1 to stop the browser opening automatically.
AGENTPROOF_NO_BROWSER=0
# Optional overrides (defaults: ./data/agentproof.db)
# AGENTPROOF_DB=C:/path/to/agentproof.db
# AGENTPROOF_DATA_DIR=C:/path/to/data

# --- LLM judge / LLM stand-in agent --------------------------------------
# Anthropic (Claude). Default model: claude-opus-5-5
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Any OpenAI-compatible endpoint (OpenAI, Azure proxy, vLLM, Ollama, LM Studio ...)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# auto | anthropic | openai  (auto prefers Anthropic when both keys are set)
LLM_PROVIDER=auto
# Voice channel: true = real TTS -> STT round trip via the OpenAI-compatible audio API
VOICE_ROUNDTRIP=false
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_STT_MODEL=whisper-1

# --- NICE CXone (Digital / Bot) --------------------------------------------
CXONE_AUTH_URL=https://cxone.niceincontact.com/auth/token
# Your tenant's API host, e.g. https://api-na1.niceincontact.com
CXONE_API_BASE_URL=
CXONE_CLIENT_ID=
CXONE_CLIENT_SECRET=
CXONE_ACCESS_KEY_ID=
CXONE_ACCESS_KEY_SECRET=
CXONE_BUSINESS_UNIT=
CXONE_CHANNEL_ID=
CXONE_POINT_OF_CONTACT=
